              SQLTask:Connection="{9937C32E-D1E5-4AA7-B265-40CCE59AAB73}"
              SQLTask:SqlStatementSource="MERGE INTO dbo.DW_FactInventory AS Target&#xA;USING [ContosoRetail_Staging].[dbo].[Valid_FactInventory] AS Source  &#xA;ON Target.InventoryKey = Source.InventoryKey&#xA;WHEN MATCHED THEN&#xA;    UPDATE SET&#xA;        Target.OnHandQuantity = Source.OnHandQuantity,&#xA;        Target.UnitCost = Source.UnitCost,&#xA;        Target.TotalInventoryValue = Source.OnHandQuantity * Source.UnitCost,&#xA;        Target.LoadDate = GETDATE()&#xA;WHEN NOT MATCHED THEN&#xA;    INSERT (InventoryKey, DateKey, StoreKey, ProductKey, CurrencyKey, &#xA;            OnHandQuantity, OnOrderQuantity, SafetyStockQuantity, UnitCost, TotalInventoryValue, LoadDate)&#xA;    VALUES (Source.InventoryKey, Source.DateKey, Source.StoreKey, Source.ProductKey, Source.CurrencyKey, &#xA;            Source.OnHandQuantity, Source.OnOrderQuantity, Source.SafetyStockQuantity, Source.UnitCost, &#xA;            Source.OnHandQuantity * Source.UnitCost, GETDATE());" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
